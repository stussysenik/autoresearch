{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhino-nlcli.local/schemas/rhino/runtime.schema.json",
  "title": "RhinoRuntimeDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bridge_kind",
    "runtime_version",
    "transport",
    "endpoint",
    "license_status",
    "supported_methods"
  ],
  "properties": {
    "bridge_kind": {
      "type": "string",
      "enum": ["mock-rhino", "rhino-inside"]
    },
    "runtime_version": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "type": "string",
      "enum": ["unix", "named-pipe"]
    },
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "license_status": {
      "type": "string",
      "enum": ["unknown", "licensed", "evaluation", "unavailable", "unlicensed", "not_applicable"]
    },
    "supported_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
